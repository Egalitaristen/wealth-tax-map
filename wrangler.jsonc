// Deploys the built site (_site/) to Cloudflare as static assets, with a small Worker (worker/index.js) that
// stores supporter suggestions from the /suggest form in D1.
// Build and deploy from a local checkout:  python scripts/deploy.py
{
  "name": "wealth-tax-supporters",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    // Only the API runs the Worker first; every other request is served straight from the assets.
    "run_worker_first": ["/api/*"],
    // Client-side routes such as /gb or /gb/A0001 get index.html.
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    // Suggestions from the /suggest form; schema in infra/d1/suggestions.sql. Review: python scripts/suggestions.py
    {"binding": "DB", "database_name": "wts-suggestions", "database_id": "922ea23d-2e29-42b6-abbb-5354ffd54f7e"}
  ],
  "workers_dev": true,
  "routes": [
    {"pattern": "wealthtaxsupporters.com", "custom_domain": true},
    {"pattern": "www.wealthtaxsupporters.com", "custom_domain": true}
  ]
}
